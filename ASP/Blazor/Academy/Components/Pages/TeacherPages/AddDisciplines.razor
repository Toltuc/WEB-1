@using Academy.Models;
@using Microsoft.EntityFrameworkCore;
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory;

@* <h3>AddDisciplines</h3> *@

<div>
	<h5>Выберите дисциплину</h5>
	<InputSelect id="tdr-discipline" @bind-Value="discipline" class="form-control">
		<option value="-1" disabled>--- Выберите дисциплину ---</option>
		@foreach (Discipline d in Disciplines)
		{
			<option value="@d.discipline_id">@d.discipline_name</option>
		}
	</InputSelect>
	<button type="button" class="btn btn-primary" @onclick="AddDiscipline">Добавить</button>
	<ul>
		@foreach (TeachersDisciplinesRelation tdr in NewDisciplines)
		{
			<li>@tdr.Discipline.discipline_name</li>
		}
	</ul>
	<hr />
	<ul>
		@foreach (TeachersDisciplinesRelation tdr in TDR)
		{
			<li>@tdr.Discipline.discipline_name</li>
		}
	</ul>
	<hr />
</div>

@code
{
	[Parameter]
	public Teacher Teacher { get; set; }

	ICollection<Discipline> Disciplines { get; set; }
	List<TeachersDisciplinesRelation> TDR { get; set; } = new List<TeachersDisciplinesRelation>();
	List<TeachersDisciplinesRelation> NewDisciplines = new List<TeachersDisciplinesRelation>();

	int discipline = -1;

	protected override void OnInitialized()
	{
		using Academy.Data.AcademyContext context = DbFactory.CreateDbContext();
		Disciplines = context.Disciplines.ToList();
		TDR = context.TeachersDisciplinesRelation
							.Include(t => t.Discipline)
							.Where(t => t.teacher == Teacher.teacher_id)
							.ToList();
	}

	async Task AddDiscipline()
	{
		if (discipline == -1 || TDR.Any(t => t.discipline == discipline))
		{
			return;
		}

		TeachersDisciplinesRelation tdr;
		using (Academy.Data.AcademyContext context = DbFactory.CreateDbContext())
		{
			tdr = new TeachersDisciplinesRelation()
			{
				teacher = Teacher.teacher_id,
				discipline = discipline
			};
			context.TeachersDisciplinesRelation.Add(tdr);
			await context.SaveChangesAsync();
			tdr.Discipline = context.Disciplines.Find(discipline);
		}

		NewDisciplines.Add(tdr);
		TDR.Add(tdr);
		discipline = -1;
	}
}
